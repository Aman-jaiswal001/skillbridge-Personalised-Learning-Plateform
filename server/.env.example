PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/skillbridge-ai
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

LLM_PROVIDER=fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

EMBEDDING_PROVIDER=fallback
EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=

VECTOR_DB=local
MONGODB_VECTOR_INDEX=document_chunks_vector
MONGODB_VECTOR_PATH=embedding

IGOT_ADAPTER=mock

CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE=20971520
ASSESSMENT_IMPORT_MAX_FILE_SIZE=5242880
ASSESSMENT_IMPORT_MAX_ROWS=1000
QUIZ_REVIEW_THRESHOLD=50
QUIZ_ADVANCE_THRESHOLD=80
UPLOAD_DIR=uploads
# Legacy local PDFs remain served from this private persistent volume.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
